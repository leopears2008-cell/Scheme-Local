# ---- copy to backend/.env for local dev. NEVER commit real values. ----
ENV=development                      # set to "production" on Render
GEMINI_API_KEY=                      # server only
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=                   # public anon key
SUPABASE_SERVICE_ROLE_KEY=           # SECRET: server only, bypasses RLS
SUPABASE_JWT_SECRET=                 # only for legacy HS256 projects; otherwise leave empty (JWKS is used)
SUPER_ADMIN_PHONES=                  # +91XXXXXXXXXX,... bootstrap super admins
ALLOWED_SOURCE_DOMAINS=              # e.g. pmkisan.gov.in,nic.in (empty = any *.gov.in / *.nic.in)
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false                    # true behind Render
FRESH_LOGIN_MINUTES=15
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AI=20
MAX_BODY_BYTES=1000000
MAX_UPLOAD_BYTES=12000000
GEMINI_TIMEOUT_S=45

# ---- demo / judging (defaults are the safe production values)
DEMO_AUTH_ENABLED=false          # true = demo accounts may sign in with email+password (no SMS). Judging only.
DEMO_AUTH_EMAILS=                # comma-separated allowlist of demo emails; nobody else is admitted this way
ALLOW_JSON_FALLBACK=false        # true = serve bundled scheme JSON when the database table is empty (logs a warning)

# ---- guest mode (no OTP, no password; limited; see docs/GUEST_MODE.md)
GUEST_ENABLED=false             # production: set false if you do not want guests
GUEST_TOKEN_SECRET=              # REQUIRED in production when GUEST_ENABLED=true: openssl rand -hex 32
GUEST_TTL_S=7200                 # guest session lifetime (2 hours)
GUEST_ASK_PER_10MIN=10           # questions per guest per 10 minutes
GUEST_ASK_PER_DAY=40             # questions per guest per day
GUEST_SESSIONS_PER_IP_PER_HOUR=5 # new guest sessions per network per hour
