# =============================================================================
# SchemeLocal – Backend Environment Variables
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values. NEVER commit .env to git.
# 3. Run:  bash ../scripts/run.sh   (or .\scripts\run.ps1 on Windows)
#
# WHICH KEYS DO WHAT
# ------------------
# Without any keys:  Find + Check work (local JSON data, TF-IDF retrieval).
# GEMINI_API_KEY:    Unlocks Talk (AI chat), Docs scan (OCR), Voice, Translation.
# SUPABASE_*:        Unlocks user accounts, Apply history, Admin dashboard.
# GUEST_TOKEN_SECRET: Required if GUEST_ENABLED=true in production.
#
# KEY SECURITY RULES
# ------------------
# - SUPABASE_SERVICE_ROLE_KEY must NEVER go in the frontend .env.
# - GEMINI_API_KEY is server-side only.
# - Anon key (SUPABASE_ANON_KEY) is the only Supabase key that belongs in frontend.
# =============================================================================

ENV=development                      # set to "production" on Render

# ── Gemini (server only) ──────────────────────────────────────────────────────
GEMINI_API_KEY=                      # Get from https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_SMALL=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TIMEOUT_S=45

# ── Supabase (server only, except ANON_KEY which also goes in frontend) ───────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=                   # public anon key — also needed in frontend/.env
SUPABASE_SERVICE_ROLE_KEY=           # SECRET: server only, bypasses RLS — NEVER share
SUPABASE_JWT_SECRET=                 # only for legacy HS256 projects; leave empty otherwise

# ── Auth & access ─────────────────────────────────────────────────────────────
SUPER_ADMIN_PHONES=                  # +91XXXXXXXXXX,... bootstrap super-admins
ALLOWED_SOURCE_DOMAINS=              # e.g. pmkisan.gov.in,nic.in (empty = any *.gov.in / *.nic.in)
CORS_ORIGINS=http://localhost:5173   # space-separated list in production: https://schemelocal.vercel.app
TRUST_PROXY=false                    # true behind Render's load balancer

# ── Rate limits ───────────────────────────────────────────────────────────────
FRESH_LOGIN_MINUTES=15               # admin verify/reject needs a recent OTP login
RATE_LIMIT_DEFAULT=120               # requests / minute / client IP
RATE_LIMIT_AI=20                     # for /api/ask, /api/ocr, /api/voice, /api/translate
MAX_BODY_BYTES=1000000               # 1 MB
MAX_UPLOAD_BYTES=12000000            # 12 MB (base64 images/audio)

# ── Guest mode (no account required; limited) ─────────────────────────────────
GUEST_ENABLED=true                   # false in production unless you set GUEST_TOKEN_SECRET
GUEST_TOKEN_SECRET=                  # REQUIRED in production: openssl rand -hex 32
GUEST_TTL_S=7200                     # guest session lifetime (2 hours)
GUEST_ASK_PER_10MIN=10               # AI questions per guest per 10 minutes
GUEST_ASK_PER_DAY=40                 # AI questions per guest per day
GUEST_SESSIONS_PER_IP_PER_HOUR=5    # new guest sessions per IP per hour

# ── Demo / judging (hackathon only; default = safe production values) ─────────
DEMO_AUTH_ENABLED=false          # true = named judge emails can sign in without SMS
DEMO_AUTH_EMAILS=                # comma-separated allowlist: judge@example.com
ALLOW_JSON_FALLBACK=true         # true = serve bundled JSON when Supabase table is empty (logs a warning)

# ── Retrieval (Option A: Gemini Embeddings hybrid) ────────────────────────────
# If GEMINI_API_KEY is set, semantic Gemini embeddings are used and cached to disk.
# If not set, automatic fallback to in-memory BM25/TF-IDF (keyword only).
EMBEDDING_CACHE_DIR=                 # leave empty for default: backend/embedding_cache/
EMBEDDING_TIMEOUT_S=10               # Gemini embedding API timeout before BM25 fallback
