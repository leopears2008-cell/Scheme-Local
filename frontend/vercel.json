{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://*.onrender.com http://localhost:8000; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob: data:; frame-ancestors 'none'" }
    ]}
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
